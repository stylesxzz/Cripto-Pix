# Banco persistente (Neon/PostgreSQL). Em produção, DATABASE_URL é obrigatório.
# Localmente, deixe vazio para usar SQLite.
DATABASE_URL=

# Gere duas strings aleatórias longas e diferentes. Não compartilhe nem publique.
APP_SESSION_SECRET=troque-por-uma-chave-aleatoria-longa
APP_ENCRYPTION_KEY=troque-por-outra-chave-aleatoria-longa

# Configurações opcionais do painel
DB_PATH=cripto_pix_v2.db
MAX_BRL=2000
MIN_SUB_BRL=100
